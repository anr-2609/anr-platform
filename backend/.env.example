# Server Configuration
SERVER_PORT=8080
SERVER_ENV=development # development | production
SERVER_TIMEOUT_READ=10s
SERVER_TIMEOUT_WRITE=10s
SERVER_TIMEOUT_IDLE=120s

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=anr_user
DB_PASSWORD=anr_password_change_me
DB_NAME=anr_platform
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_CONN_LIFETIME=1h

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Auth Configuration
JWT_SECRET=super_secret_jwt_key_at_least_32_bytes_long!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h # 7 days
