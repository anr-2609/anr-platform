# ANR Platform Root Environment Configuration

# Application
SERVER_PORT=8080
SERVER_ENV=production

# Database (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_USER=anr_user
DB_PASSWORD=change_this_to_a_secure_password
DB_NAME=anr_platform
DB_SSLMODE=disable
DB_ENABLED=true

# Cache (Redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_ENABLED=true

# Security & Auth
JWT_SECRET=change_me_to_at_least_32_characters_random_string_in_production
